], quads[3]\), Math.max\(quads[5], quads[7]\)\);              \r\n    if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj15 0 obj<</JS(function ShowCompProps_6E08008D99C34F63A42B27F13092AF7B\(\){var sChoice = app.popUpMenu\("Comment: SMA-2","Component Kind: Standard","Description: ","Footprint: SMA-2","Ibis Model: ","Library Name: Yixin_AD1716.IntLib","Library Reference: CHIP_ANTENNA_1",\"PCB3D: ","Pin Info: ","Signal Integrity: ","Simulation: "\); if \(sChoice\) {var nUrlPos = sChoice.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.s\earch\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sChoice.substr\(nPathPos+2\)\);};};})/S/JavaScript>>endobj16 0 obj<</JS(function ShowCompProps_2C0A31B729234978907051EBEBB125C2\(\){var sChoice = app.popUpMenu\("Comment: BEEP","Component Kind: Standard","Description: ","Footprint: BELL-5","Ibis Model: ","Library Name: Yixin_AD1716.IntLib","Library Reference: BEEP_1","PCB3D: \","Pin Info: ","Signal Integrity: ","Simulation: "\); if \(sChoice\) {var nUrlPos = sChoice.search\